# Supabase public client configuration (safe to expose only when using publishable/anon key)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy Supabase anon key is also accepted if this project still uses it.
VITE_SUPABASE_ANON_KEY=

# Server-side Supabase configuration (never expose in VITE_ variables)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# TMDB server-side credentials (never expose in VITE_ variables)
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=
